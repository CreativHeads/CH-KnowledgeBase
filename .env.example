# Copy this file to .env.local for running on your own computer.
# On Vercel, add the same names under Settings → Environment Variables (never commit real values).

# --- Supabase database (Project Settings → Database → Connection string → Transaction pooler) ---
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Supabase storage, for reference images (Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=brand-refs

# --- The address the app is served from. Must match the Microsoft redirect URI. ---
APP_URL=https://your-brandroom.vercel.app

# --- Signs the short-lived sign-in cookie. Any long random string. ---
APP_SECRET=change-me-to-a-long-random-string

# --- Microsoft 365 sign-in (Entra ID app registration) ---
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-application-client-id
MS_CLIENT_SECRET=your-client-secret
MS_ALLOWED_DOMAIN=creativheads.com
MS_DEFAULT_ROLE=staff

# --- Knowledge API: lets the SEO agent and other tools READ brand knowledge. Format  name:key,name2:key2
# Each key must be at least 24 characters. Make one per tool. Leave empty to switch the API off.
KB_API_KEYS=seo-agent:replace-with-a-long-random-string

# --- Optional: shown in the account menu as a link back to the SEO app ---
SEO_URL=
