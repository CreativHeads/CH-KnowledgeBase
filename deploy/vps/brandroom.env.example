# Copy to /etc/brandroom.env on the VPS, fill in the values, and lock it:
#   sudo chown root:brandroom /etc/brandroom.env && sudo chmod 640 /etc/brandroom.env
# Use the same values as in Vercel (Project → Settings → Environment Variables). Never put this file in GitHub.
APP_URL=https://kb.creativheads.com
APP_SECRET=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=brand-refs
OPENAI_API_KEY=
OPENAI_MODEL=
KB_API_KEYS=
# Microsoft 365 sign-in, only if you use it:
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_ALLOWED_DOMAIN=creativheads.com
SEO_URL=
